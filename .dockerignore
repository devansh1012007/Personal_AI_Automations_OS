# Keep the build context tiny and secret-free. Only pyproject, README and src/
# are needed to build the wheel; everything else is noise or risk.

# VCS / tooling
.git
.github
.gitignore
.venv
venv
*.egg-info
.mypy_cache
.ruff_cache
.pytest_cache
__pycache__
*.pyc
*.pyo

# Tests and docs are not needed inside the image
tests
docs

# Deployment scaffolding is mounted by compose from the host, never built into
# the runtime image: deploy/postgres/initdb (a bind mount for the postgres
# container) and the worker/toolbox Dockerfiles (built with their own, much
# smaller contexts).
deploy

# Local state and secrets must never enter an image layer
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
data
cold_lake
state

# Editor / OS cruft
.idea
.vscode
.DS_Store
Thumbs.db

# Container artefacts themselves
Dockerfile
docker-compose*.yml
.dockerignore
