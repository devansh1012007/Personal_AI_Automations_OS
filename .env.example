# =====================================================================
# PAA Docker deployment environment (docs/adr/0019, docs/deployment/docker.md).
#
# Copy to `.env` and fill in real secrets before `docker compose up`:
#     cp .env.example .env
#
# `.env` is git-ignored and .dockerignore-d — it must never enter an image
# layer or the repo. Nothing here is a real credential; generate your own.
#
# Two kinds of variable live here:
#   * compose-substitution vars (POSTGRES_*, MINIO_*) — expanded by docker
#     compose into service configuration and connection strings.
#   * PAA_* runtime settings — read by pydantic-settings (env_prefix "PAA_",
#     nested delimiter "__"). Most PAA_* values are set directly in
#     docker-compose.yml; override them here only when you need to.
# =====================================================================

# ---- PostgreSQL (relational substrate + ledger) ----------------------
# Used both to init the postgres container and to build PAA_STORAGE__POSTGRES_DSN
# (postgresql://<user>:<password>@postgres:5432/<db>) in docker-compose.yml.
POSTGRES_USER=paa
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=paa

# ---- MinIO (cold-lake object store) ----------------------------------
# Root credentials for the MinIO server. The runtime reads the *same* values via
# PAA_MINIO_ACCESS_KEY / PAA_MINIO_SECRET_KEY (the names configured in
# StorageSettings.minio_access_key_env / minio_secret_key_env).
MINIO_ROOT_USER=paa
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars
MINIO_BUCKET=paa-cold-lake

# ---- Model escalation (optional) -------------------------------------
# The frontier tier is only called when a task escalates (ModelSettings). Leave
# blank to run local-only. The key is read from the env var named by
# ModelSettings.escalation_api_key_env (default ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=

# ---- Primary model (laptop default, and what `paa agent` uses) ---------
# Deliberately separate from the Docker stack above: this block is what a
# laptop-only install needs. `paa agent` reads it alongside everything else
# from `.env` in the CURRENT WORKING DIRECTORY, so run `paa` from the repo root.
#
# OpenRouter keys go here, never in config. ModelSettings stores only the NAME
# of an env var (escalation_api_key_env, plus the registry row's api_key_env) —
# the same indirection StorageSettings uses for MinIO — so a credential cannot
# end up in config, in the ledger, or in an image layer.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# LOCAL_PROVIDER names the router's FIRST slot, not a locality claim. The
# `openrouter` registry row declares tier = FRONTIER, so `leaves_machine` in any
# escalation record stays truthful even when this slot holds a hosted model.
PAA_MODELS__LOCAL_PROVIDER=openrouter
# Any OpenRouter model id works. The `:free` tier is $0 in / $0 out.
PAA_MODELS__LOCAL_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Single-provider setup: no frontier tier, so every call goes to the slot above.
# Remove this (or name another registry row) to enable ADR-0015 escalation —
# and then set the key var that row expects (ANTHROPIC_API_KEY by default).
PAA_MODELS__ESCALATION_PROVIDER=none

# ---- Runtime overrides (optional) ------------------------------------
# Uncomment to change behaviour without editing docker-compose.yml.
#
# Sandbox containment runtime. `runc` = namespaces; `runsc` = gVisor (requires
# the gvisor override and runsc installed on the host — see
# docker-compose.gvisor.yml).
# PAA_SANDBOX__CONTAINER_RUNTIME=runc
#
# Permission mode. The runtime enum (core/types.py) is
# AUTO | ASK | SUPERVISED | LOCKDOWN | SAFE | HIGH_RISK — ASK and SUPERVISED
# both make every mutating call require a human gate. `paa mode <name>` prints
# the exact value to export. NOTE: `paa agent --mode` takes the *coder's*
# enum, a different lowercase set: ask | accept_edits | plan | bypass.
# PAA_POLICY__MODE=ASK
#
# Observability: point at an OTLP collector to export traces off-box. When
# unset, traces stay in the local ledger only (no egress).
# PAA_OBSERVABILITY__OTLP_ENDPOINT=
